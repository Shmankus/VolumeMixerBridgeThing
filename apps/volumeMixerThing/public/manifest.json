{
  "id": "01a07c59-bf95-7267-93ee-ba147aaff75d",
  "name": "volumeMixerThing",
  "version": "1.4.0",
  "description": "Windows app volume mixer with BridgeThing media controls.",
  "config": [
    {
      "type": "string",
      "data": {
        "key": "tracked_apps",
        "label": "Tracked Apps 'Firefox|{firefox,mozilla firefox},etc' (empty = default)"
      }
    },
    {
      "type": "boolean",
      "data": {
        "key": "useArtworkColor",
        "label": "Use Artwork Color for Media Colors"
      }
    },
    {
      "type": "string",
      "data": {
        "key": "media_bg_color",
        "label": "Media Background Color (e.g. #ff5269 )"
      }
    }
    
  ],
  "permissions": ["forward"],
  "art": {
    "heroPx": 248,
    "thumbPx": 96
  },
  "extension": {
    "entry": "extension/desktop.mjs",
    "permissions": ["run", "read:extension"],
    "api": 1
  }
}


